[discord]
token = "YOUR_DISCORD_BOT_TOKEN"
admin_guild_id = "YOUR_ADMIN_GUILD_ID"

[database]
path = "./bridge.db"

[bridge]
socket_path = "/tmp/bridge.sock"

[servers.my-server]
network = "tcp" # or "unix"
address = "127.0.0.1:25575" # or "/run/minecraft/my-server.rcon"
password = "your_rcon_password"
# Path to whitelist.json for reliable removal (especially for Bedrock/Offline players)
whitelist_path = "/srv/minecraft/my-server/whitelist.json"
